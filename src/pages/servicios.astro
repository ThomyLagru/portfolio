---
import "../styles/global.css";

const paquetes = [
  {
    nombre: "Básico",
    precio: "$350",
    moneda: "USD",
    tagline: "Presencia digital profesional en 48 hs",
    destacado: false,
    badge: null,
    incluye: [
      "Landing page 1 página (Astro + Tailwind)",
      "Diseño mobile-first responsivo",
      "Formulario de contacto funcional",
      "Deploy en Vercel con dominio propio",
      "SEO básico (meta tags, Open Graph)",
      "PageSpeed > 90 garantizado",
    ],
    noIncluye: [
      "Chatbot WhatsApp",
      "Automatizaciones n8n",
      "CRM / Airtable",
    ],
    entrega: "48 horas",
    revisiones: "2",
    soporte: "7 días",
    retainer: "$80 USD/mes",
  },
  {
    nombre: "Estándar",
    precio: "$600",
    moneda: "USD",
    tagline: "Landing + chatbot que trabaja 24/7 por vos",
    destacado: true,
    badge: "Más vendido",
    incluye: [
      "Todo lo del paquete Básico",
      "Chatbot WhatsApp con Botpress Cloud",
      "Respuestas automáticas a preguntas frecuentes",
      "Consulta y reserva de turnos por WhatsApp",
      "Derivación a humano con un comando",
      "Panel de conversaciones incluido",
    ],
    noIncluye: [
      "Automatizaciones n8n",
      "CRM / Airtable",
    ],
    entrega: "72 horas",
    revisiones: "3",
    soporte: "14 días",
    retainer: "$120 USD/mes",
  },
  {
    nombre: "Premium",
    precio: "$950",
    moneda: "USD",
    tagline: "Sistema completo de captación automática",
    destacado: false,
    badge: null,
    incluye: [
      "Todo lo del paquete Estándar",
      "Automatización n8n: lead → WhatsApp → CRM",
      "Dashboard de leads en Airtable",
      "Email automático de bienvenida / confirmación",
      "Integración con Google Calendar (turnos)",
      "30 días de soporte prioritario incluido",
    ],
    noIncluye: [],
    entrega: "5–7 días",
    revisiones: "Sin límite (en scope)",
    soporte: "30 días",
    retainer: "$150 USD/mes",
  },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Servicios y precios · Thomas Lagrutta</title>
    <meta name="description" content="Paquetes de landing pages y automatizaciones. Precios cerrados, entrega rápida. Astro, Tailwind, Vercel, Botpress, n8n." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
    <style>
      .dot-pattern {
        background-image: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px);
        background-size: 28px 28px;
      }
    </style>
  </head>
  <body class="bg-zinc-950 text-white" style="font-family: 'Inter', sans-serif;">

    <!-- NAVBAR -->
    <nav class="fixed top-0 left-0 right-0 z-50 border-b border-zinc-800/50 bg-zinc-950/80 backdrop-blur-md">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="font-bold text-lg">TL<span class="text-zinc-500">.</span></a>
        <div class="hidden md:flex items-center gap-8 text-zinc-400">
          <a href="/#proyectos" class="hover:text-white transition text-sm">Proyectos</a>
          <a href="/#proceso" class="hover:text-white transition text-sm">Proceso</a>
          <a href="/#calculadora" class="hover:text-white transition text-sm">Calculadora</a>
          <a href="/servicios" class="text-white transition text-sm">Servicios</a>
          <a href="/#contacto" class="hover:text-white transition text-sm">Contacto</a>
          <a href="https://www.workana.com/freelancer/e0f658019ea3a2e2fa168a619c66bcc5" target="_blank"
            class="bg-white hover:bg-zinc-200 transition px-5 py-2 rounded-full text-sm font-semibold text-zinc-900">
            Contratar en Workana
          </a>
        </div>
        <a href="/#contacto" class="md:hidden bg-white text-zinc-900 px-4 py-2 rounded-full text-sm font-semibold">
          Contacto
        </a>
      </div>
    </nav>

    <!-- ENCABEZADO DE PÁGINA -->
    <section class="dot-pattern pt-32 pb-16 px-6">
      <div class="max-w-5xl mx-auto">
        <p class="text-zinc-500 text-sm font-semibold uppercase tracking-widest mb-4">Paquetes</p>
        <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-6">Servicios y precios</h1>
        <p class="text-zinc-400 text-xl max-w-2xl">
          Tres paquetes pensados para distintos momentos de tu negocio. Precio cerrado, sin sorpresas.
        </p>
      </div>
    </section>

    <!-- GRILLA DE PAQUETES -->
    <section class="pb-24 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-3 gap-6">
          {paquetes.map((p) => (
            <div class={`relative flex flex-col rounded-2xl p-8 transition-all duration-300 ${
              p.destacado
                ? 'bg-zinc-900 border border-emerald-500/40 shadow-[0_0_40px_rgba(16,185,129,0.07)]'
                : 'bg-zinc-900 border border-zinc-800 hover:border-zinc-600'
            }`}>

              {/* Badge "Más vendido" posicionado arriba del card */}
              {p.badge && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                  <span class="bg-emerald-500 text-zinc-950 text-xs font-bold px-4 py-1.5 rounded-full whitespace-nowrap">
                    {p.badge}
                  </span>
                </div>
              )}

              {/* Encabezado: nombre, precio y tagline */}
              <div class="mb-6">
                <h2 class="text-sm font-semibold text-zinc-500 uppercase tracking-widest mb-3">{p.nombre}</h2>
                <div class="flex items-baseline gap-1.5 mb-3">
                  <span class="text-4xl font-extrabold">{p.precio}</span>
                  <span class="text-zinc-500 font-medium text-sm">{p.moneda}</span>
                </div>
                <p class={`text-sm leading-relaxed ${p.destacado ? 'text-emerald-300' : 'text-zinc-400'}`}>{p.tagline}</p>
              </div>

              {/* Lista de lo que incluye */}
              <div class="flex-1 mb-6">
                <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-3">Incluye</p>
                <ul class="space-y-2.5">
                  {p.incluye.map((item) => (
                    <li class="flex items-start gap-2.5 text-sm text-zinc-300">
                      <span class="text-emerald-400 font-bold mt-0.5 shrink-0 leading-none">✓</span>
                      {item}
                    </li>
                  ))}
                </ul>

                {/* Lista de lo que no incluye (condicional) */}
                {p.noIncluye.length > 0 && (
                  <div class="mt-5">
                    <p class="text-xs font-semibold uppercase tracking-widest text-zinc-700 mb-3">No incluye</p>
                    <ul class="space-y-2.5">
                      {p.noIncluye.map((item) => (
                        <li class="flex items-start gap-2.5 text-sm text-zinc-600">
                          <span class="font-bold mt-0.5 shrink-0 leading-none">✗</span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>

              {/* Detalles al pie: entrega, revisiones, soporte y retainer */}
              <div class="mt-auto border-t border-zinc-800 pt-5 space-y-2.5">
                <div class="flex justify-between items-center text-sm">
                  <span class="text-zinc-500">Entrega</span>
                  <span class="text-zinc-300 font-medium">{p.entrega}</span>
                </div>
                <div class="flex justify-between items-center text-sm">
                  <span class="text-zinc-500">Revisiones</span>
                  <span class="text-zinc-300 font-medium">{p.revisiones}</span>
                </div>
                <div class="flex justify-between items-center text-sm">
                  <span class="text-zinc-500">Soporte</span>
                  <span class="text-zinc-300 font-medium">{p.soporte}</span>
                </div>
                <div class="flex justify-between items-center text-sm pt-2 mt-1 border-t border-zinc-800">
                  <span class="text-zinc-500">Retainer opcional</span>
                  <span class={`font-semibold ${p.destacado ? 'text-emerald-400' : 'text-zinc-300'}`}>{p.retainer}</span>
                </div>
              </div>

            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECCIÓN: POR QUÉ ESTE STACK -->
    <section class="py-16 px-6 border-t border-zinc-800/50">
      <div class="max-w-5xl mx-auto">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-10 md:p-12">
          <p class="text-zinc-500 text-sm font-semibold uppercase tracking-widest mb-4">Stack</p>
          <h2 class="text-3xl font-bold mb-4">¿Por qué trabajo con este stack?</h2>
          <p class="text-zinc-400 text-lg leading-relaxed max-w-2xl">
            Uso Astro, Tailwind, Vercel, Botpress y n8n para entregar sitios rápidos, bien optimizados y con automatizaciones reales. Sin pagebuilders, sin templates genéricos.
          </p>
          <div class="flex flex-wrap gap-3 mt-8">
            {["Astro", "Tailwind CSS", "Vercel", "Botpress", "n8n", "Airtable"].map((tech) => (
              <span class="bg-zinc-800 border border-zinc-700 text-zinc-300 px-4 py-2 rounded-full text-sm font-medium">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL CON WHATSAPP -->
    <section class="py-24 px-6 border-t border-zinc-800/50">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-zinc-500 text-sm font-semibold uppercase tracking-widest mb-4">¿Dudas?</p>
        <h2 class="text-4xl md:text-5xl font-bold mb-6">¿Tenés dudas sobre qué paquete elegir?</h2>
        <p class="text-zinc-400 text-lg mb-10 max-w-xl mx-auto">
          Escribime por WhatsApp y en minutos te ayudo a entender cuál encaja mejor con tu proyecto.
        </p>
        <a
          href="https://wa.me/+5491133960100"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-white hover:bg-zinc-200 active:scale-95 transition-all px-8 py-4 rounded-full font-semibold text-zinc-900 text-lg"
        >
          <!-- Ícono de WhatsApp -->
          <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Hablemos por WhatsApp
        </a>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-zinc-800/50 py-8 px-6">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
        <a href="/" class="font-bold text-zinc-400">Thomas Lagrutta</a>
        <p class="text-xs text-zinc-700">© 2026 · Hecho con Astro y Tailwind CSS · Buenos Aires, Argentina</p>
      </div>
    </footer>

  </body>
</html>
